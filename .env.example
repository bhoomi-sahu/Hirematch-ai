# ============================================================
# Used by `docker compose up` (docker-compose.yml reads this file).
# Copy this to `.env` in the project root and fill in real values.
# This is SEPARATE from backend/.env and frontend/.env, which are
# only used when running the servers directly with npm (not Docker).
# ============================================================

# Required: any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

JWT_EXPIRES_IN=7d

# Optional: enables live AI parsing/matching/improvement calls (Google Gemini).
# Leave blank to run entirely on the built-in deterministic fallback — the
# app works fully without this, just with less nuanced AI text.
# Get a key at https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=

# Origin allowed to call the backend directly (only matters if you call
# the API from somewhere other than the bundled frontend, e.g. Postman
# from a different origin). The bundled frontend talks to the backend
# through Nginx's same-origin /api proxy, so CORS doesn't apply there.
CORS_ORIGIN=http://localhost:3000

# Max resume PDF upload size in MB
RESUME_MAX_SIZE_MB=5
