# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Use 127.0.0.1 for explicit IPv4 loopback)
MONGODB_URI=mongodb://127.0.0.1:27017/jobmatch_ai

# Client Configuration
CORS_ORIGIN=http://localhost:5173

# Authentication (Prepared for next phase)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# LLM / AI Configuration (Prepared for next phase)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Resume Upload Configuration
RESUME_MAX_SIZE_MB=5
